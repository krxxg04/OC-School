---
import BaseHead from '../components/BaseHead.astro';
import Logo from '../assets/OC.png';

const PAGE_TITLE = 'Planner Personal | OC School';
const PAGE_DESCRIPTION =
	'Gestor de tareas y agenda con horario de Lima, persistencia local y notificaciones del navegador.';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={PAGE_TITLE} description={PAGE_DESCRIPTION} />
	</head>
	<body data-app-icon-url={Logo.src}>
		<main class="planner-page">
			<section class="planner-card" aria-label="Aplicacion de productividad">
				<header class="hero">
					<img src={Logo.src} width="168" height="168" alt="Logo del planner" class="hero-logo" />
					<div>
						<p class="eyebrow">OC-SCHOOL</p>
						<h1>Planner de Tareas & Agenda</h1>
						<p class="subtitle">Organiza pendientes y eventos con horario en una sola vista.</p>
					</div>
				</header>

				<div class="planner-grid">
					<section class="panel" aria-label="Lista de tareas">
						<h2 class="panel-title">Tareas del dia</h2>

						<form class="todo-form" data-todo-form>
							<label for="task-input" class="sr-only">Nueva tarea</label>
							<input
								id="task-input"
								type="text"
								name="task"
								autocomplete="off"
								maxlength="120"
								placeholder="Escribe una tarea..."
								class="field-input"
								required
							/>
							<button type="submit" class="primary-button">Agregar</button>
						</form>

						<p class="input-help">Tip: presiona Enter para agregar rapido una tarea.</p>

						<div class="toolbar" aria-live="polite">
							<p class="summary-text" data-task-summary>0 pendientes | 0 completadas</p>
							<button type="button" class="ghost-button" data-clear-completed>
								Limpiar completadas
							</button>
						</div>

						<ul class="todo-list" data-todo-list aria-live="polite"></ul>
					</section>

					<section class="panel" aria-label="Agenda con horario">
						<h2 class="panel-title">Agenda y calendario</h2>

						<form class="agenda-form" data-event-form>
							<label for="event-title" class="sr-only">Nombre del evento</label>
							<input
								id="event-title"
								type="text"
								name="eventTitle"
								maxlength="120"
								placeholder="Ej. Reunion de proyecto"
								class="field-input"
								required
							/>
							<label for="event-date" class="sr-only">Fecha del evento</label>
							<label for="event-time" class="sr-only">Hora del evento</label>
							<div class="agenda-form-row">
								<input
									id="event-date"
									type="date"
									name="eventDate"
									class="field-input"
									required
								/>
								<input
									id="event-time"
									type="time"
									name="eventTime"
									class="field-input"
									required
								/>
							</div>
							<button type="submit" class="primary-button">Agendar</button>
						</form>

						<p class="input-help">Programa actividades con fecha y hora exactas de Lima.</p>

						<div class="toolbar" aria-live="polite">
							<p class="summary-text" data-event-summary>0 proximos | 0 vencidos</p>
							<div class="toolbar-actions">
								<button type="button" class="ghost-button" data-clear-past>Limpiar vencidos</button>
								<button type="button" class="ghost-button" data-enable-notifications>
									Activar notificaciones
								</button>
							</div>
						</div>

						<p class="notification-help" data-notification-help>
							Las notificaciones funcionan cuando esta pestana permanece abierta.
						</p>

						<ul class="agenda-list" data-event-list aria-live="polite"></ul>
					</section>
				</div>
			</section>
		</main>

		<script>
			interface Task {
				id: string;
				text: string;
				completed: boolean;
			}

			interface CalendarEvent {
				id: string;
				title: string;
				startsAt: string;
				notified: boolean;
			}

			const TASK_STORAGE_KEY = 'oc-school.todo.tasks';
			const EVENT_STORAGE_KEY = 'oc-school.calendar.events';
			const LIMA_TIME_ZONE = 'America/Lima';
			const LIMA_OFFSET = '-05:00';
			const MAX_NOTIFICATION_DELAY = 2_147_483_647;
			const APP_ICON_URL = document.body.dataset.appIconUrl ?? '/favicon.svg';

			const todoForm = document.querySelector<HTMLFormElement>('[data-todo-form]');
			const taskInput = document.querySelector<HTMLInputElement>('#task-input');
			const todoList = document.querySelector<HTMLUListElement>('[data-todo-list]');
			const taskSummary = document.querySelector<HTMLParagraphElement>('[data-task-summary]');
			const clearCompletedButton = document.querySelector<HTMLButtonElement>(
				'[data-clear-completed]',
			);

			const eventForm = document.querySelector<HTMLFormElement>('[data-event-form]');
			const eventTitleInput = document.querySelector<HTMLInputElement>('#event-title');
			const eventDateInput = document.querySelector<HTMLInputElement>('#event-date');
			const eventTimeInput = document.querySelector<HTMLInputElement>('#event-time');
			const eventList = document.querySelector<HTMLUListElement>('[data-event-list]');
			const eventSummary = document.querySelector<HTMLParagraphElement>('[data-event-summary]');
			const clearPastButton = document.querySelector<HTMLButtonElement>('[data-clear-past]');
			const enableNotificationsButton = document.querySelector<HTMLButtonElement>(
				'[data-enable-notifications]',
			);
			const notificationHelp = document.querySelector<HTMLParagraphElement>(
				'[data-notification-help]',
			);

			const eventDateTimeFormatter = new Intl.DateTimeFormat('es-PE', {
				timeZone: LIMA_TIME_ZONE,
				dateStyle: 'medium',
				timeStyle: 'short',
			});

			const limaPartsFormatter = new Intl.DateTimeFormat('en-CA', {
				timeZone: LIMA_TIME_ZONE,
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
				hourCycle: 'h23',
			});

			const notificationTimers = new Map<string, number>();

			const createId = (): string => {
				if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
					return crypto.randomUUID();
				}

				return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
			};

			const LEGACY_SEED_TEXTS = new Set(['Avanzar entregable de Ciclo VI', 'Estudiar para la practica']);

			const getLimaParts = (date: Date): { date: string; time: string } => {
				const parts = limaPartsFormatter.formatToParts(date);
				const pick = (type: Intl.DateTimeFormatPartTypes): string =>
					parts.find((part) => part.type === type)?.value ?? '';

				const year = pick('year');
				const month = pick('month');
				const day = pick('day');
				const hour = pick('hour');
				const minute = pick('minute');

				return {
					date: `${year}-${month}-${day}`,
					time: `${hour}:${minute}`,
				};
			};

			const toLimaIsoDateTime = (dateValue: string, timeValue: string): string | null => {
				if (!dateValue || !timeValue) {
					return null;
				}

				const iso = `${dateValue}T${timeValue}:00${LIMA_OFFSET}`;
				const parsed = new Date(iso);
				if (Number.isNaN(parsed.getTime())) {
					return null;
				}

				return parsed.toISOString();
			};

			const parseTask = (value: unknown): Task | null => {
				if (!value || typeof value !== 'object') {
					return null;
				}

				const candidate = value as Partial<Task>;
				if (
					typeof candidate.id !== 'string' ||
					typeof candidate.text !== 'string' ||
					typeof candidate.completed !== 'boolean'
				) {
					return null;
				}

				return {
					id: candidate.id,
					text: candidate.text,
					completed: candidate.completed,
				};
			};

			const parseEvent = (value: unknown): CalendarEvent | null => {
				if (!value || typeof value !== 'object') {
					return null;
				}

				const candidate = value as Partial<CalendarEvent>;
				if (
					typeof candidate.id !== 'string' ||
					typeof candidate.title !== 'string' ||
					typeof candidate.startsAt !== 'string'
				) {
					return null;
				}

				const startsAtMs = new Date(candidate.startsAt).getTime();
				if (Number.isNaN(startsAtMs)) {
					return null;
				}

				return {
					id: candidate.id,
					title: candidate.title,
					startsAt: new Date(startsAtMs).toISOString(),
					notified: typeof candidate.notified === 'boolean' ? candidate.notified : false,
				};
			};

			const loadTasks = (): Task[] => {
				try {
					const raw = localStorage.getItem(TASK_STORAGE_KEY);
					if (!raw) {
						return [];
					}

					const parsed = JSON.parse(raw);
					if (!Array.isArray(parsed)) {
						return [];
					}

					return parsed
						.map((item) => parseTask(item))
						.filter((task): task is Task => task !== null);
				} catch {
					return [];
				}
			};

			const loadEvents = (): CalendarEvent[] => {
				try {
					const raw = localStorage.getItem(EVENT_STORAGE_KEY);
					if (!raw) {
						return [];
					}

					const parsed = JSON.parse(raw);
					if (!Array.isArray(parsed)) {
						return [];
					}

					return parsed
						.map((item) => parseEvent(item))
						.filter((event): event is CalendarEvent => event !== null);
				} catch {
					return [];
				}
			};

			const saveTasks = (tasks: Task[]): void => {
				localStorage.setItem(TASK_STORAGE_KEY, JSON.stringify(tasks));
			};

			const saveEvents = (events: CalendarEvent[]): void => {
				localStorage.setItem(EVENT_STORAGE_KEY, JSON.stringify(events));
			};

			const sortEvents = (events: CalendarEvent[]): CalendarEvent[] => {
				return [...events].sort(
					(a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime(),
				);
			};

			const ensureInitialTasks = (): Task[] => {
				const tasks = loadTasks();
				if (tasks.length === 1) {
					const [task] = tasks;
					if (!task.completed && LEGACY_SEED_TEXTS.has(task.text.trim())) {
						saveTasks([]);
						return [];
					}
				}

				saveTasks(tasks);
				return tasks;
			};

			const formatEventDateTime = (startsAt: string): string => {
				return eventDateTimeFormatter.format(new Date(startsAt));
			};

			const getEventStatus = (startsAt: string): { label: string; className: string } => {
				const delta = new Date(startsAt).getTime() - Date.now();
				if (delta < 0) {
					return { label: 'Vencido', className: 'is-overdue' };
				}

				if (delta <= 24 * 60 * 60 * 1000) {
					return { label: 'Hoy', className: 'is-today' };
				}

				return { label: 'Proximo', className: 'is-upcoming' };
			};

			const clearNotificationTimers = (): void => {
				for (const timerId of notificationTimers.values()) {
					window.clearTimeout(timerId);
				}
				notificationTimers.clear();
			};

			const updateNotificationUi = (): void => {
				if (!enableNotificationsButton || !notificationHelp) {
					return;
				}

				if (typeof Notification === 'undefined') {
					enableNotificationsButton.disabled = true;
					enableNotificationsButton.textContent = 'No disponible';
					notificationHelp.textContent =
						'Tu navegador no soporta notificaciones web para recordatorios.';
					return;
				}

				if (Notification.permission === 'granted') {
					enableNotificationsButton.disabled = true;
					enableNotificationsButton.textContent = 'Notificaciones activas';
					notificationHelp.textContent =
						'Recibiras recordatorios en hora de Lima mientras la pestana siga abierta.';
					return;
				}

				if (Notification.permission === 'denied') {
					enableNotificationsButton.disabled = true;
					enableNotificationsButton.textContent = 'Notificaciones bloqueadas';
					notificationHelp.textContent =
						'Habilitalas manualmente en tu navegador para recibir recordatorios.';
					return;
				}

				enableNotificationsButton.disabled = false;
				enableNotificationsButton.textContent = 'Activar notificaciones';
				notificationHelp.textContent =
					'Activalas para recibir avisos cuando llegue la hora agendada en Lima.';
			};

			const scheduleEventNotifications = (
				events: CalendarEvent[],
				onTriggered: (eventId: string) => void,
			): void => {
				clearNotificationTimers();

				if (typeof Notification === 'undefined' || Notification.permission !== 'granted') {
					return;
				}

				const now = Date.now();
				for (const event of events) {
					if (event.notified) {
						continue;
					}

					const triggerAt = new Date(event.startsAt).getTime();
					const delay = triggerAt - now;
					if (delay <= 0 || delay > MAX_NOTIFICATION_DELAY) {
						continue;
					}

					const timerId = window.setTimeout(() => {
						if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
							new Notification('Recordatorio de agenda', {
								body: `${event.title} - ${formatEventDateTime(event.startsAt)} (Lima)`,
								icon: APP_ICON_URL,
							});
						}
						onTriggered(event.id);
					}, delay);

					notificationTimers.set(event.id, timerId);
				}
			};

			const createTaskElement = (task: Task): HTMLLIElement => {
				const item = document.createElement('li');
				item.className = `todo-item${task.completed ? ' is-completed' : ''}`;
				item.dataset.taskId = task.id;

				const label = document.createElement('label');
				label.className = 'task-label';

				const checkbox = document.createElement('input');
				checkbox.type = 'checkbox';
				checkbox.checked = task.completed;
				checkbox.setAttribute('aria-label', `Completar ${task.text}`);

				const text = document.createElement('span');
				text.textContent = task.text;

				const removeButton = document.createElement('button');
				removeButton.type = 'button';
				removeButton.textContent = 'Eliminar';
				removeButton.className = 'delete-button';
				removeButton.dataset.action = 'delete-task';

				label.append(checkbox, text);
				item.append(label, removeButton);
				return item;
			};

			const createEventElement = (event: CalendarEvent): HTMLLIElement => {
				const status = getEventStatus(event.startsAt);

				const item = document.createElement('li');
				item.className = `agenda-item ${status.className}`;
				item.dataset.eventId = event.id;

				const info = document.createElement('div');
				info.className = 'agenda-info';

				const titleRow = document.createElement('div');
				titleRow.className = 'agenda-top';

				const title = document.createElement('p');
				title.className = 'agenda-title';
				title.textContent = event.title;

				const badge = document.createElement('span');
				badge.className = 'event-badge';
				badge.textContent = status.label;

				const when = document.createElement('p');
				when.className = 'agenda-when';
				when.textContent = `${formatEventDateTime(event.startsAt)} (Lima)`;

				const removeButton = document.createElement('button');
				removeButton.type = 'button';
				removeButton.textContent = 'Eliminar';
				removeButton.className = 'delete-button';
				removeButton.dataset.action = 'delete-event';

				titleRow.append(title, badge);
				info.append(titleRow, when);
				item.append(info, removeButton);
				return item;
			};

			const updateTaskSummary = (tasks: Task[]): void => {
				if (taskSummary) {
					const completed = tasks.filter((task) => task.completed).length;
					const pending = tasks.length - completed;
					taskSummary.textContent = `${pending} pendientes | ${completed} completadas`;
				}

				if (clearCompletedButton) {
					clearCompletedButton.disabled = !tasks.some((task) => task.completed);
				}
			};

			const updateEventSummary = (events: CalendarEvent[]): void => {
				if (eventSummary) {
					const now = Date.now();
					const overdue = events.filter((event) => new Date(event.startsAt).getTime() < now).length;
					const upcoming = events.length - overdue;
					eventSummary.textContent = `${upcoming} proximos | ${overdue} vencidos`;
				}

				if (clearPastButton) {
					const now = Date.now();
					clearPastButton.disabled = !events.some(
						(event) => new Date(event.startsAt).getTime() < now,
					);
				}
			};

			const renderTasks = (tasks: Task[]): void => {
				updateTaskSummary(tasks);
				if (!todoList) {
					return;
				}

				todoList.innerHTML = '';
				if (tasks.length === 0) {
					const empty = document.createElement('li');
					empty.className = 'empty-state';
					empty.textContent = 'No tienes tareas pendientes. Agrega una nueva tarea.';
					todoList.appendChild(empty);
					return;
				}

				const fragment = document.createDocumentFragment();
				for (const task of tasks) {
					fragment.appendChild(createTaskElement(task));
				}
				todoList.appendChild(fragment);
			};

			const renderEvents = (events: CalendarEvent[]): void => {
				updateEventSummary(events);
				if (!eventList) {
					return;
				}

				eventList.innerHTML = '';
				if (events.length === 0) {
					const empty = document.createElement('li');
					empty.className = 'empty-state';
					empty.textContent = 'No hay eventos agendados por el momento.';
					eventList.appendChild(empty);
					return;
				}

				const fragment = document.createDocumentFragment();
				for (const event of events) {
					fragment.appendChild(createEventElement(event));
				}
				eventList.appendChild(fragment);
			};

			const setDefaultEventDateTime = (): void => {
				if (!eventDateInput || !eventTimeInput) {
					return;
				}

				const inThirtyMinutes = new Date(Date.now() + 30 * 60 * 1000);
				const values = getLimaParts(inThirtyMinutes);
				eventDateInput.value = values.date;
				eventTimeInput.value = values.time;
			};

			if (todoForm && taskInput && todoList) {
				let tasks = ensureInitialTasks();
				renderTasks(tasks);

				todoForm.addEventListener('submit', (event) => {
					event.preventDefault();
					const text = taskInput.value.trim();
					if (!text) {
						return;
					}

					tasks = [{ id: createId(), text, completed: false }, ...tasks];
					saveTasks(tasks);
					renderTasks(tasks);
					todoForm.reset();
					taskInput.focus();
				});

				todoList.addEventListener('change', (event) => {
					const target = event.target;
					if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') {
						return;
					}

					const item = target.closest<HTMLLIElement>('[data-task-id]');
					const taskId = item?.dataset.taskId;
					if (!taskId) {
						return;
					}

					tasks = tasks.map((task) =>
						task.id === taskId ? { ...task, completed: target.checked } : task,
					);

					saveTasks(tasks);
					renderTasks(tasks);
				});

				todoList.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof HTMLElement)) {
						return;
					}

					const deleteButton = target.closest<HTMLButtonElement>('[data-action="delete-task"]');
					if (!deleteButton) {
						return;
					}

					const item = deleteButton.closest<HTMLLIElement>('[data-task-id]');
					const taskId = item?.dataset.taskId;
					if (!taskId) {
						return;
					}

					tasks = tasks.filter((task) => task.id !== taskId);
					saveTasks(tasks);
					renderTasks(tasks);
				});

				clearCompletedButton?.addEventListener('click', () => {
					tasks = tasks.filter((task) => !task.completed);
					saveTasks(tasks);
					renderTasks(tasks);
				});
			}

			if (eventForm && eventTitleInput && eventDateInput && eventTimeInput && eventList) {
				let events = sortEvents(loadEvents());

				const markEventNotified = (eventId: string): void => {
					events = events.map((event) =>
						event.id === eventId ? { ...event, notified: true } : event,
					);
					saveEvents(events);
					renderEvents(events);
					scheduleEventNotifications(events, markEventNotified);
				};

				const persistAndRenderEvents = (nextEvents: CalendarEvent[]): void => {
					events = sortEvents(nextEvents);
					saveEvents(events);
					renderEvents(events);
					scheduleEventNotifications(events, markEventNotified);
				};

				updateNotificationUi();
				setDefaultEventDateTime();
				persistAndRenderEvents(events);

				eventForm.addEventListener('submit', (event) => {
					event.preventDefault();
					const title = eventTitleInput.value.trim();
					const startsAt = toLimaIsoDateTime(eventDateInput.value, eventTimeInput.value);
					if (!title || !startsAt) {
						return;
					}

					persistAndRenderEvents([
						...events,
						{
							id: createId(),
							title,
							startsAt,
							notified: false,
						},
					]);

					eventTitleInput.value = '';
					eventTitleInput.focus();
				});

				eventList.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof HTMLElement)) {
						return;
					}

					const deleteButton = target.closest<HTMLButtonElement>('[data-action="delete-event"]');
					if (!deleteButton) {
						return;
					}

					const item = deleteButton.closest<HTMLLIElement>('[data-event-id]');
					const eventId = item?.dataset.eventId;
					if (!eventId) {
						return;
					}

					persistAndRenderEvents(events.filter((entry) => entry.id !== eventId));
				});

				clearPastButton?.addEventListener('click', () => {
					const now = Date.now();
					persistAndRenderEvents(
						events.filter((entry) => new Date(entry.startsAt).getTime() >= now),
					);
				});

				enableNotificationsButton?.addEventListener('click', async () => {
					if (typeof Notification === 'undefined') {
						return;
					}

					await Notification.requestPermission();
					updateNotificationUi();
					scheduleEventNotifications(events, markEventNotified);
				});

				window.addEventListener('beforeunload', () => {
					clearNotificationTimers();
				});
			}
		</script>
	</body>
</html>

<style>
	:global(:root) {
		--todo-blue-800: #163f66;
		--todo-blue-700: #1f4f7d;
		--todo-blue-600: #2f6fa8;
		--todo-blue-500: #4389cb;
		--todo-blue-300: #b6d7f4;
		--todo-blue-200: #d6e7f8;
		--todo-blue-100: #edf5fc;
		--todo-white: #ffffff;
	}

	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 12% 20%, rgba(84, 141, 210, 0.2), transparent 42%),
			radial-gradient(circle at 86% 12%, rgba(120, 187, 255, 0.22), transparent 30%),
			linear-gradient(160deg, #eaf3fd 0%, #ffffff 45%, #f1f8ff 100%);
		color: #163b5d;
		font-family: var(--font-atkinson), 'Trebuchet MS', sans-serif;
		font-size: 17px;
		line-height: 1.5;
	}

	.planner-page {
		display: grid;
		place-items: center;
		width: 100%;
		max-width: none;
		margin: 0;
		min-height: 100vh;
		padding: 2.75rem 1.25rem;
	}

	.planner-card {
